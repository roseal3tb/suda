rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function admin() { return request.auth != null && request.auth.token.get('admin', false) == true; }
    match /users/{uid} {
      allow read: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['name','email','profile','displayRole','portfolioLegacyMigrated','enrollmentsLegacyMigrated']);
      allow delete: if false;
      match /works/{workId} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.keys().hasOnly(['id','title','description'])
          && request.resource.data.id == workId
          && request.resource.data.title is string
          && request.resource.data.description is string
          && request.resource.data.title.size() > 0
          && request.resource.data.description.size() > 0;
      }
      match /enrollments/{courseId} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.keys().hasOnly(['courseId','progress','achievements'])
          && request.resource.data.courseId == courseId
          && request.resource.data.progress is number
          && request.resource.data.progress >= 0
          && request.resource.data.progress <= 100
          && request.resource.data.achievements is list;
      }
    }
    // Public opportunities must never contain private meeting URLs.
    match /opportunities/{id} {
      allow read: if true;
      allow create, update: if admin()
        && !request.resource.data.keys().hasAny(['zoomUrl','meetingUrl'])
        && request.resource.data.title is string
        && request.resource.data.type in ['الدورات','المسابقات','التدريب','الفرص الوظيفية'];
      allow delete: if admin();
    }
    match /courseMeetingLinks/{courseId} {
      allow get: if admin() || (request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/enrollments/$(courseId)));
      allow list: if admin();
      allow write: if admin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
