+              >
+                إلغاء
+              </Button>
+            </div>
+          </form>
+        )}
+      </Modal>
+      <ConfirmDelete
+        open={Boolean(deleting)}
+        onClose={() => setDeleting(null)}
+        name={deleting?.title || ""}
+        onConfirm={() => {
+          if (deleting && deleteOpportunity(deleting.id)) setDeleting(null);
