+          <Reveal className="profile-person">
+            <div className="profile-avatar">{profile.name.charAt(0)}</div>
+            <span className="eyebrow">الملف المهني</span>
+            <h2>{profile.name}</h2>
+            <p>{profile.bio || "لم تُضاف نبذة بعد."}</p>
+          </Reveal>
+          <div>
+            <Reveal as="section" className="profile-section" delay={0.15}>
+              <h2>المهارات</h2>
+              <div className="chips">
+                {profile.skills.map((skill, i) => (
+                  <span className="chip" key={i}>
+                    {skill}
+                  </span>
+                ))}
+              </div>
+            </Reveal>
+            <Reveal as="section" className="profile-section" delay={0.3}>
+              <h2>الاهتمامات</h2>
+              <div className="chips">
+                {profile.interests.map((interest, i) => (
+                  <span className="chip" key={i}>
+                    {interest}
+                  </span>
+                ))}
+              </div>
+            </Reveal>
+            <Reveal as="section" className="profile-section" delay={0.45}>
+              <h2>الخبرات</h2>
+              <p>{profile.experience || "لم تُضاف خبرات بعد."}</p>
+            </Reveal>
+          </div>
+        </div>
+      ) : (
+        <EmptyState
+          title="ملفك المهني"
+          description="ابدئي باسمك، أضيفي مهاراتك واهتماماتك، وأكملي نبذتك المهنية."
+          action={
+            <Button variant="outline" onClick={start}>
+              <Plus />
+              إنشاء ملفي المهني
+            </Button>
+          }
+        />
+      )}
+      <DemoNote />
+      <Modal
+        open={editing}
+        onClose={() => setEditing(false)}
+        title={profile ? "تعديل الملف المهني" : "إنشاء الملف المهني"}
+      >
+        <form className="form-stack" onSubmit={submit} noValidate>
+          <FormField label="الاسم *">
+            <input
+              value={form.name}
+              onChange={(e) => setForm({ ...form, name: e.target.value })}
+            />
+          </FormField>
+          <FormField label="نبذة عني">
+            <textarea
+              value={form.bio}
+              onChange={(e) => setForm({ ...form, bio: e.target.value })}
+              placeholder="عن شغفك وأسلوبك في التصميم"
+            />
+          </FormField>
+          <FormField label="المهارات *" hint="افصلي بين المهارات بفاصلة.">
+            <input
+              value={form.skills}
+              onChange={(e) => setForm({ ...form, skills: e.target.value })}
+              placeholder="رسم الأزياء، الباترون، الخياطة"
+            />
+          </FormField>
+          <FormField label="الاهتمامات *" hint="افصلي بين الاهتمامات بفاصلة.">
+            <input
+              value={form.interests}
+              onChange={(e) => setForm({ ...form, interests: e.target.value })}
+              placeholder="الأزياء التراثية، الأقمشة، التشكيل"
+            />
+          </FormField>
+          <FormField label="الخبرات">
+            <textarea
+              value={form.experience}
+              onChange={(e) => setForm({ ...form, experience: e.target.value })}
+              placeholder="مشروعاتك الدراسية أو تجاربك السابقة"
+            />
+          </FormField>
+          {error && (
+            <p className="form-error" role="alert">
+              {error}
+            </p>
+          )}
+          <div className="form-actions">
+            <Button type="submit">
+              حفظ الملف <Check />
+            </Button>
+            <Button
+              type="button"
+              variant="outline"
+              onClick={() => setEditing(false)}
+            >
+              إلغاء
+            </Button>
+          </div>
+        </form>
+      </Modal>
+    </div>
+  );
+}
